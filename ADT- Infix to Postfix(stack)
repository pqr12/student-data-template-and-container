#include <iostream>
#include <string>
#include <cctype>
using namespace std;
class Node // Node of Singly Linked List
{
public:
char data;
Node *next;
Node(char value)
{
data = value;
next = NULL;
}
};
// Stack ADT using Linked List
class Stack
{
Node *top;
public:
Stack()
{
top = NULL;
}
void push(char value)
{
Node *newNode = new Node(value);
newNode->next = top;
top = newNode;
}char pop()
{
if (top == NULL)
return '\0';
char value = top->data;
Node *temp = top;
top = top->next;
delete temp;
return value;
}
char peek()
{
if (top == NULL)
return '\0';
return top->data;
}
bool isEmpty()
{
return top == NULL;
}
};
// Check operator
bool isOperator(char ch)
{
return ch == '+' || ch == '-' || ch == '*' || ch == '/';
}
int priority(char ch) // Priority of operator
{
if (ch == '+' || ch == '-')return 1;
if (ch == '*' || ch == '/')
return 2;
return 0;
}
// Infix to Postfix
string infixToPostfix(string infix)
{
Stack s;
string postfix = "";
for (char ch : infix)
{
if (isdigit(ch))
{
postfix += ch;
}
else if (ch == '(')
{
s.push(ch);
}
else if (ch == ')')
{
while (!s.isEmpty() && s.peek() != '(')
postfix += s.pop();
s.pop(); // remove '('
}
else if (isOperator(ch))
{
while (!s.isEmpty() &&priority(s.peek()) >= priority(ch))
{
postfix += s.pop();
}
s.push(ch);
}
}
while (!s.isEmpty())
postfix += s.pop();
return postfix;
}
// Evaluate Postfix
int evaluatePostfix(string postfix)
{
Stack s;
int a, b, result;
for (char ch : postfix)
{
if (isdigit(ch))
{
s.push(ch - '0');
}
else if (isOperator(ch))
{
b = s.pop();
a = s.pop();
switch (ch)
{case '+':
result = a + b;
break;
case '-':
result = a - b;
break;
case '*':
result = a * b;
break;
case '/':
result = a / b;
break;
}
s.push(result);
}
}
return s.pop();
}
int main()
{
string infix, postfix;
cout << "Enter infix expression: ";
cin >> infix;
postfix = infixToPostfix(infix);
cout << "Postfix expression: " << postfix << endl;
cout << "Result: " << evaluatePostfix(postfix) << endl;
return 0;
}
